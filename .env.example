# ---------------------------------------------------------------------
# Copiar a .env.local. Sin ninguna de estas variables la app corre en
# modo local (store en memoria) y el demo funciona igual.
# ---------------------------------------------------------------------

# local | supabase
NEXT_PUBLIC_DATOS=local

# --- Paneles del equipo (ver README, «Quién puede escribir») ----------

# Contraseña de /admin. Sin ella el panel de administración no abre.
ADMIN_CLAVE=

# Firma las cookies de sesión (admin y reporteros). Obligatoria en
# producción, mínimo 32 caracteres. Generar con: openssl rand -base64 32
# En desarrollo, si falta, se inventa una por proceso.
SESION_SECRETO=

# Llave para mandar posiciones sin sesión de reportero: la usa
# `npm run simular` contra un despliegue. En modo local sin esta llave
# la ingesta queda abierta (modo desarrollo); en modo supabase, cerrada.
# INGESTA_TOKEN=

# --- Mapa base --------------------------------------------------------

# Dónde está el archivo de teselas. Por defecto /mapa/pasto.pmtiles.
# NEXT_PUBLIC_MAPA_PMTILES=

# --- Supabase (solo con NEXT_PUBLIC_DATOS=supabase) --------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA se expone al navegador ni se sube al repo. El servidor la usa para
# todo lo que escribe y para leer las tablas privadas (reporteros).
# SUPABASE_SERVICE_ROLE_KEY=
