# ---------------------------------------------------------------------
# Copiar a .env.local. Sin ninguna de estas variables la app corre en
# modo local (store en memoria) y el demo funciona igual.
# ---------------------------------------------------------------------

# local | supabase
NEXT_PUBLIC_DATOS=local

# Solo hacen falta con NEXT_PUBLIC_DATOS=supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA se expone al navegador ni se sube al repo. Solo la usa el servidor
# para insertar posiciones saltándose RLS.
# SUPABASE_SERVICE_ROLE_KEY=
