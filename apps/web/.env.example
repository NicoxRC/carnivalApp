# Copy to .env.local. The web has no backend of its own: its data comes from
# apps/backend/.

# The backend's address. In development, when missing, http://localhost:8000
# (`just dev`) is used. In production it is required: `next build` fails
# without it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Another path ON THE SAME DOMAIN for the tiles file. Defaults to
# /map/pasto.pmtiles. From another domain the map is not available offline.
# NEXT_PUBLIC_MAP_PMTILES=
