# ---------------------------------------------------------------------
# Copiar a .env.local. La web ya no tiene backend propio: los datos
# salen del backend de apps/backend/.
# ---------------------------------------------------------------------

# Dirección del backend. En desarrollo, si falta, se usa
# http://localhost:8000 (`just dev`). En producción es obligatoria:
# `next build` falla sin ella.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Mapa base --------------------------------------------------------

# Otra ruta DEL MISMO DOMINIO para el archivo de teselas. Por defecto
# /mapa/pasto.pmtiles. Desde otro dominio el mapa no queda disponible sin red.
# NEXT_PUBLIC_MAPA_PMTILES=
